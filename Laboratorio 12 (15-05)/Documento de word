#include <iostream>
using namespace std;
void mostrarMenu()
{
    cout << "PLANES DEL GIMNASIO" << endl;
    cout << "1. Basico - 100 Bs" << endl;
    cout << "2. Intermedio - 180 Bs" << endl;
    cout << "3. Premium - 250 Bs" << endl;
}
float obtenerPrecio(int plan)
{
    if(plan == 1)
    return 100;
    else if(plan == 2)
    return 180;
    else if(plan == 3)
    return 250;
    else
    return 0;
}
float calcularSubtotal(float precio, int meses)
{
return precio * meses;
}
float calculardescuento(float subtotal, int meses)
{
    if(meses > 3)
    {
    subtotal = subtotal - (subtotal * 0.15);
    }
    return subtotal;
}
void mostrarresultado(string nombre, float total)
{
    cout << "\n--- FACTURA ---" << endl;
    cout << "Cliente: " << nombre << endl;
    cout << "Total a pagar: " << total << " Bs" << endl;
}
int main()
{
    string nombre;
    int plan, meses;
    float precio, subtotal, total;
    cout << "Nombre del cliente: ";
    cin >> nombre;
    mostrarMenu();
    cout << "Elija un plan (1-3): ";
    cin >> plan;
    cout << "Cantidad de meses: ";
    cin >> meses;
    precio = obtenerprecio(plan);
    subtotal = calcularsubtotal(precio, meses);
    total = calculardescuento(subtotal, meses);
    mostrarresultado(nombre, total);

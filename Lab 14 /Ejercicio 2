#include <iostream>
#include <string>
using namespace std;
void leerDatos(int &cantidad, string preguntas[]);
void mostrarResultado(string preguntas[], int cantidad);
int main() {
    int cantidad;
    string preguntas[100];
    cout << "Ingrese la cantidad de preguntas: ";
    cin >> cantidad;
    getchar();
    leerDatos(cantidad, preguntas);
    mostrarResultado(preguntas, cantidad);
    return 0;
}
void leerDatos(int &cantidad, string preguntas[]) {
    for(int i = 0; i < cantidad; i++) {
        do {
            cout << "\nPregunta " << i + 1 << ":" << endl;
            getline(cin, preguntas[i]);
            if(preguntas[i].length() == 0) {
                cout << "La pregunta no puede estar vacia." << endl;
            }
            else if(preguntas[i].at(0) == ' ' ||
                    preguntas[i].at(preguntas[i].length() - 1) == ' ') {

                cout << "La pregunta no puede tener espacios al inicio o al final." << endl;
            }
        } while(preguntas[i].length() == 0 ||
                preguntas[i].at(0) == ' ' ||
                preguntas[i].at(preguntas[i].length() - 1) == ' ');
    }
}
void mostrarResultado(string preguntas[], int cantidad) {
    cout << "\n===== PREGUNTAS REGISTRADAS =====" << endl;
    for(int i = 0; i < cantidad; i++) {
        cout << i + 1 << ". " << preguntas[i] << endl;
    }
}
